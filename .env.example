# Optional: absolute public origin for shared links / Open Graph images.
# Leave empty to use the current deployment host (including Vercel previews).
# Set only after a production domain has been chosen, then redeploy.
SITE_URL=

# AI voice demo. Copy to .env.local; never use NEXT_PUBLIC_ for secrets.
OPENAI_API_KEY=
GEMINI_API_KEY=
# Free Gemini is restricted to synthetic development utterances.
VOICE_GEMINI_FREE_TIER=true
# Required for production/remote demo. Exact scheme + host + optional port.
VOICE_ALLOWED_ORIGIN=
VOICE_DEMO_ACCESS_CODE=
